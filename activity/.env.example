# Application ID (General Information tab). Public — exposed to the browser on purpose
# because Vite only forwards VITE_-prefixed variables. The server reads the same value.
VITE_DISCORD_CLIENT_ID=

# OAuth2 tab -> Client Secret. SERVER ONLY. Never prefix with VITE_.
DISCORD_CLIENT_SECRET=

# Express port. Vite proxies /api to this port in dev.
PORT=3001
